<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="600.0" prefWidth="900.0" stylesheets="@../styles/MainStyles.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1">

    <!-- ========================================== -->
    <!-- 1. BARRA SUPERIOR (HEADER)                 -->
    <!-- ========================================== -->
    <top>
        <HBox fx:id="headerBox" alignment="CENTER_LEFT" spacing="20.0">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
         
            <ImageView fx:id="imgLogo" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />
            <Label fx:id="lblTitle" text="Catálogo de Propiedades" />
         
            <Region HBox.hgrow="ALWAYS" />
         
            <Button fx:id="btnLogin" text="Iniciar Sesión" />
            <Button fx:id="btnRegister" text="Registrarse" />
        </HBox>
    </top>

    <!-- ========================================== -->
    <!-- 2. CONTENIDO CENTRAL                       -->
    <!-- ========================================== -->
    <center>
        <VBox fx:id="centerBox" spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- SECCIÓN DE BÚSQUEDA Y FILTROS -->
            <HBox fx:id="searchBox" alignment="CENTER_LEFT" spacing="15.0">
                <TextField fx:id="txtSearch" promptText="Buscar por nombre o ubicación..." HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="cmbType" prefWidth="150.0" promptText="Tipo de Inmueble" />
                <Button fx:id="btnSearch" text="Buscar" />
            </HBox>

            <!-- SECCIÓN DE TARJETAS (GRID CON SCROLL) -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                <GridPane fx:id="gridCards" hgap="20.0" vgap="20.0">
               
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="300.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="300.0" />
                    </columnConstraints>
               
                    <!-- Tarjeta 1 -->
                    <VBox fx:id="card1" spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <ImageView fx:id="imgProp1" fitHeight="150.0" fitWidth="300.0" preserveRatio="false" />
                        <Label fx:id="lblTitle1" text="Nombre de la Propiedad 1" />
                        <Label fx:id="lblDesc1" text="Descripción breve de la propiedad." wrapText="true" />
                        <Button fx:id="btnDetails1" maxWidth="Infinity" text="Ver Detalles" />
                    </VBox>

                    <!-- Tarjeta 2 -->
                    <VBox fx:id="card2" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <ImageView fx:id="imgProp2" fitHeight="150.0" fitWidth="300.0" preserveRatio="false" />
                        <Label fx:id="lblTitle2" text="Nombre de la Propiedad 2" />
                        <Label fx:id="lblDesc2" text="Descripción breve de la propiedad." wrapText="true" />
                        <Button fx:id="btnDetails2" maxWidth="Infinity" text="Ver Detalles" />
                    </VBox>

                    <!-- Tarjeta 3 -->
                    <VBox fx:id="card3" spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <ImageView fx:id="imgProp3" fitHeight="150.0" fitWidth="300.0" preserveRatio="false" />
                        <Label fx:id="lblTitle3" text="Nombre de la Propiedad 3" />
                        <Label fx:id="lblDesc3" text="Descripción breve de la propiedad." wrapText="true" />
                        <Button fx:id="btnDetails3" maxWidth="Infinity" text="Ver Detalles" />
                    </VBox>

                    <!-- Tarjeta 4 -->
                    <VBox fx:id="card4" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <padding>
                            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                        </padding>
                        <ImageView fx:id="imgProp4" fitHeight="150.0" fitWidth="300.0" preserveRatio="false" />
                        <Label fx:id="lblTitle4" text="Nombre de la Propiedad 4" />
                        <Label fx:id="lblDesc4" text="Descripción breve de la propiedad." wrapText="true" />
                        <Button fx:id="btnDetails4" maxWidth="Infinity" text="Ver Detalles" />
                    </VBox>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>

                </GridPane>
            </ScrollPane>
        </VBox>
    </center>

    <!-- ========================================== -->
    <!-- 3. PIE DE PÁGINA (FOOTER)                  -->
    <!-- ========================================== -->
    <bottom>
        <HBox fx:id="footerBox" alignment="CENTER_LEFT">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <Label fx:id="lblResults" text="Mostrando 4 resultados" />
        </HBox>
    </bottom>

</BorderPane>
