<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="540.0" prefWidth="920.0" stylesheets="@../styles/DashboardViewStyles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tu.paquete.ControladorHorizonte">

   <!-- VBOX PRINCIPAL (Panel que cubre toda la ventana) -->
   <VBox fx:id="panelPrincipal" spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
      <padding>
         <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
      </padding>

      <HBox fx:id="headerBox" alignment="CENTER_LEFT" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>

         <ImageView fx:id="imgLogo" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />

         <Label fx:id="lblTitulo" text="Horizonte Urbano" />

         <Region HBox.hgrow="ALWAYS" />

         <ImageView fx:id="imgPerfil" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />

         <Label fx:id="lblUsuario" text="Usuario: EL USUARIO" />

         <ImageView fx:id="imgSalir" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true" />
      </HBox>

      <VBox fx:id="panelFormulario" spacing="12.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>

         <!-- Título del formulario -->
         <Label fx:id="lblTituloForm" alignment="CENTER" maxWidth="Infinity" text="Formulario de Ingreso de Datos - Nueva Propiedad" />

         <!-- Contenedor de 2 columnas -->
         <HBox fx:id="columnasForm" spacing="40.0">

            <!-- Columna Izquierda -->
            <VBox fx:id="colIzquierda" spacing="10.0" HBox.hgrow="ALWAYS">

               <Label fx:id="lblCodigo" text="Código Interno" />
               <TextField fx:id="txtCodigo" prefWidth="250.0" promptText="HU-030" />

               <Label fx:id="lblTipo" text="Tipo de Inmueble" />
               <ComboBox fx:id="cmbTipo" prefWidth="250.0" />

               <Label fx:id="lblArea" text="Área (m²)" />
               <TextField fx:id="txtArea" prefWidth="250.0" />
            </VBox>

            <!-- Columna Derecha -->
            <VBox fx:id="colDerecha" spacing="10.0" HBox.hgrow="ALWAYS">

               <Label fx:id="lblDireccion" text="Dirección Exacta" />
               <TextField fx:id="txtDireccion" prefWidth="250.0" />

               <Label fx:id="lblEstado" text="Estado Actual" />
               <ComboBox fx:id="cmbEstado" prefWidth="250.0" />

               <Label fx:id="lblPrecio" text="Precio de Oferta" />
               <TextField fx:id="txtPrecio" prefWidth="250.0" />
            </VBox>
         </HBox>

         <!-- Sección Descripción -->
         <VBox fx:id="seccionDescripcion" spacing="5.0">
            <Label fx:id="lblDescripcion" text="Descripción Breve / Observaciones" />
            <TextArea fx:id="txtDescripcion" prefHeight="80.0" wrapText="true" />
         </VBox>

         <!-- Botones de acción -->
         <HBox fx:id="botonesBox" alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="btnLimpiar" mnemonicParsing="false" prefWidth="110.0" text="Limpiar" />
            <Button fx:id="btnCancelar" mnemonicParsing="false" prefWidth="110.0" text="Cancelar" />
            <Button fx:id="btnGuardar" mnemonicParsing="false" prefWidth="140.0" text="Guardar Propiedad" />
         </HBox>
      </VBox>

      <VBox fx:id="panelRegistros" spacing="5.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>

         <Label fx:id="lblRegistros" text="Últimos Registros de la Sesión" />

         <ListView fx:id="listRegistros" prefHeight="80.0" />
      </VBox>

      <HBox fx:id="footerBox" alignment="CENTER_LEFT" spacing="10.0">
         <Label fx:id="lblEstado" text="Estado: Ingreso de datos pendiente" />
         <Region HBox.hgrow="ALWAYS" />
         <ImageView fx:id="imgReloj" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true" />
      </HBox>

   </VBox>
</AnchorPane>
