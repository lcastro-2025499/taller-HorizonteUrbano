<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<AnchorPane fx:id="rootPane" prefHeight="540.0" prefWidth="920.0" stylesheets="@../styles/MainStyles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.horizonteurbano.system.controller.ReportsController">
    <VBox spacing="25.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
        
        <HBox alignment="CENTER_LEFT">
            <Label text="Dashboard Gerencial - Reportes" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Volver al Catálogo" onAction="#actionGoBack" styleClass="btn-secondary"/>
        </HBox>
        
        <HBox spacing="20.0">
            <!-- Tarjeta 1: Conteo Total -->
            <VBox spacing="10.0" style="-fx-background-color: #472820; -fx-padding: 20; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                <Label text="Total Propiedades Activas" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                <Label fx:id="lblTotalProperties" text="0" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
            </VBox>
            
            <!-- Tarjeta 2: Valor Monetario -->
            <VBox spacing="10.0" style="-fx-background-color: #349626; -fx-padding: 20; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                <Label text="Valor Total del Inventario" style="-fx-text-fill: white; -fx-font-size: 16px;"/>
                <!-- SOLUCIÓN: Se quitó el $ del placeholder para que JavaFX no intente parsearlo como variable -->
                <Label fx:id="lblTotalValue" text="0.00" style="-fx-text-fill: white; -fx-font-size: 36px; -fx-font-weight: bold;"/>
            </VBox>
        </HBox>
        
        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <Label text="Desglose por Estado Comercial" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <ListView fx:id="listStateStats" prefHeight="200.0" VBox.vgrow="ALWAYS"/>
        </VBox>
        
    </VBox>
</AnchorPane>