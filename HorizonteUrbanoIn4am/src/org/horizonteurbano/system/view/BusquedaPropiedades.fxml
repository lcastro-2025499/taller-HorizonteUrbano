<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="540.0" prefWidth="920.0" stylesheets="@../styles/BusquedaPropiedades.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tu.paquete.ControladorBusqueda">

   <!-- VBOX PRINCIPAL -->
   <VBox fx:id="panelPrincipal" spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
      <padding>
         <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
      </padding>

      <HBox fx:id="headerBox" alignment="CENTER_LEFT" spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
         </padding>

         <ImageView fx:id="imgLogo" fitHeight="40.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true" />

         <Label fx:id="lblTitulo" text="Horizonte Urbano" />

         <Region HBox.hgrow="ALWAYS" />

         <ImageView fx:id="imgPerfil" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" />

         <Label fx:id="lblAgente" text="Agente: AGENTE" />
      </HBox>

      <VBox fx:id="panelFiltros" spacing="12.0">
         <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
         </padding>

         <!-- Fila superior: Buscador -->
         <HBox fx:id="filaBuscador" spacing="10.0">
            <TextField fx:id="txtBusqueda" prefWidth="400.0" promptText="Código o Dirección..." />
         </HBox>

         <!-- Fila inferior: Filtros -->
         <HBox fx:id="filaFiltros" alignment="CENTER_LEFT" spacing="20.0">

            <!-- Tipo de Inmueble -->
            <VBox spacing="5.0">
               <Label fx:id="lblTipo" text="Tipo de Inmueble" />
               <ComboBox fx:id="cmbTipo" prefWidth="150.0" />
            </VBox>

            <!-- Estado -->
            <VBox spacing="5.0">
               <Label fx:id="lblEstado" text="Estado" />
               <ComboBox fx:id="cmbEstado" prefWidth="150.0" />
            </VBox>

            <!-- Rango de Precio -->
            <VBox spacing="5.0">
               <Label fx:id="lblPrecio" text="Rango de Precio" />
               <HBox spacing="10.0">
                  <TextField fx:id="txtPrecioMin" prefWidth="100.0" promptText="Min" />
                  <TextField fx:id="txtPrecioMax" prefWidth="100.0" promptText="Max" />
               </HBox>
            </VBox>

            <!-- Espaciador -->
            <Region HBox.hgrow="ALWAYS" />

            <!-- Botón Buscar -->
            <Button fx:id="btnBuscar" mnemonicParsing="false" prefWidth="120.0" text="Buscar" />
         </HBox>
      </VBox>

      <TableView fx:id="tablaPropiedades" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colCodigo" prefWidth="120.0" text="Código Interno" />
            <TableColumn fx:id="colDireccion" prefWidth="250.0" text="Dirección Exacta" />
            <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
            <TableColumn fx:id="colArea" prefWidth="100.0" text="Área (m²)" />
            <TableColumn fx:id="colPrecio" prefWidth="130.0" text="Precio (Oferta)" />
            <TableColumn fx:id="colEstado" prefWidth="120.0" text="Estado" />
         </columns>
      </TableView>

      <HBox fx:id="footerBox" alignment="CENTER_LEFT" spacing="10.0">
         <Label fx:id="lblResultados" text="Resultados: 15 propiedades encontradas" />
         <Region HBox.hgrow="ALWAYS" />
         <Button fx:id="btnVerFicha" mnemonicParsing="false" prefWidth="160.0" text="Ver Ficha Detallada" />
      </HBox>

   </VBox>
</AnchorPane>
